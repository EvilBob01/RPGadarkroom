# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate a strong random string for production:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ─── Database ─────────────────────────────────────────────────────────────────
# DB_CLIENT options: sqlite3 | mysql2 | pg
DB_CLIENT=sqlite3

# SQLite (dev) — only DB_FILENAME is needed
DB_FILENAME=./data/campaign.sqlite

# MariaDB / MySQL (standard) — fill these out when DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campaign_darkroom
DB_USER=campaign_user
DB_PASSWORD=change_me

# PostgreSQL (large prod) — fill these out when DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=campaign_darkroom
# DB_USER=campaign_user
# DB_PASSWORD=change_me

# ─── Email ────────────────────────────────────────────────────────────────────
# Set MAIL_DRIVER=console in dev to print emails to stdout instead of sending
MAIL_DRIVER=console
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASSWORD=change_me
MAIL_FROM=Campaign Dark Room <noreply@example.com>

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
